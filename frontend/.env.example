# ============================================================
#  PVR Groups — Frontend Environment Variables
#  Copy this file to .env.local for development.
#  Set these as "Environment Variables" in your Vercel project.
# ============================================================

# ── Backend API URL ───────────────────────────────────────────
# In development: leave empty — Vite proxy (/api → localhost:5001) handles it.
# In production (Vercel): set to your full Render backend URL.
VITE_BACKEND_URL=https://pvr-groups-1.onrender.com

# Note: The VITE_ prefix is required by Vite to expose the variable
# to client-side code. Variables without VITE_ are server-only.
