# ============================================================
#  PVR Groups — Backend Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit the real .env to Git!
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
# On Render, set this to 10000 (Render's default exposed port)

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-minimum-32-characters
JWT_EXPIRES_IN=7d

# ── Supabase (PostgreSQL Database) ───────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Redis Cache (Upstash — free tier works great) ─────────────────────────────
# 1. Go to https://upstash.com → Create Database → Copy "REDIS_URL"
# 2. The URL starts with rediss:// (note double-s for TLS)
# 3. Set this SAME URL in Render environment variables
REDIS_URL=rediss://default:your-token@your-host.upstash.io:6379

# ── Request Timeout ───────────────────────────────────────────
# Max milliseconds before a request is force-terminated (default 10s)
REQUEST_TIMEOUT_MS=10000

# ── Node Environment ──────────────────────────────────────────
# Set to "production" on Render for structured logs + hidden stack traces
NODE_ENV=production

# ── Sentry Error Tracking ─────────────────────────────────────
# Go to sentry.io, create a Node Express project, get the DSN
SENTRY_DSN=your-sentry-dsn-here

# ── Bunny CDN (Image Storage & Delivery) ─────────────────────
# Storage API hostname (region-specific):
#   Global: storage.bunnycdn.com
#   Singapore (Asia): sg.storage.bunnycdn.com
#   Germany: de.storage.bunnycdn.com
BUNNY_STORAGE_HOSTNAME=sg.storage.bunnycdn.com

# The name of your Storage Zone (created in Bunny dashboard)
BUNNY_STORAGE_ZONE=your-storage-zone-name

# Your Storage Zone password (FTP/API key from Bunny dashboard)
BUNNY_ACCESS_KEY=your-bunny-storage-zone-password

# Your Pull Zone hostname (e.g. your-zone.b-cdn.net or custom domain)
BUNNY_CDN_DOMAIN=your-zone.b-cdn.net

# ── Frontend URL (CRITICAL for CORS) ─────────────────────────
# Set to your exact Vercel deployment URL in production.
# In development: http://localhost:5173
FRONTEND_URL=https://your-app.vercel.app

# ── Email (Nodemailer via Gmail SMTP) ────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
# Use a Gmail App Password (not your real password):
# Gmail → Account → Security → 2-Step Verification → App Passwords
EMAIL_PASS=your-16-char-gmail-app-password

# ── AI API Keys (Gemini is required, others optional) ────────
GEMINI_API_KEY=your-google-gemini-api-key
# GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# ── Legacy / Optional ─────────────────────────────────────────
# These are no longer used after the Sharp + Bunny upgrade.
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id/
# MONGODB_URI=mongodb+srv://...  (migrated to Supabase)
# TEMP_UPLOAD_PATH=./uploads     (no longer needed — memoryStorage)
# OPTIMIZED_PATH=./optimized     (no longer needed — Sharp processes in RAM)
